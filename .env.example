# Server Configuration
# Port on which the server will listen
PORT=3000

# Environment mode: development, production, or test
# Use 'development' for local development
# Use 'production' for deployment
NODE_ENV=development

# Database Configuration
# MongoDB Atlas Connection String Format:
# mongodb+srv://username:password@cluster-name.mongodb.net/database-name?appName=AppName
#
# Local MongoDB Connection String Format:
# mongodb://localhost:27017/syncspace
#
# Steps to get MongoDB Atlas URL:
# 1. Create account at https://www.mongodb.com/cloud/atlas
# 2. Create a free cluster
# 3. Click "Connect" button
# 4. Choose "Connect your application"
# 5. Copy the connection string
# 6. Replace <username> and <password> with your database user credentials
# 7. Replace <database-name> with your database name
#
DATABASE_URL=mongodb+srv://your_username:your_password@cluster-name.mongodb.net/syncspace?appName=SyncSpace

# JWT Configuration
# Secret key used to sign JWT tokens
# Requirements:
#   - Minimum 8 characters long
#   - Should be complex (mix of uppercase, lowercase, numbers, special chars)
#   - Keep it secret, don't share or commit to version control
#   - Change in production with a strong random string
#
# Generate a strong secret:
# - Use password generator: https://www.lastpass.com/password-generator
# - Or: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
#
JWT_SECRET=super_secret_key_123_change_in_production
